# OpenWA v0.23.3, release index digest (amd64 + arm64).
OPENWA_IMAGE=docker.io/rmyndharis/openwa@sha256:c00b5b589446ce7dd6177f1b871789284bcfbe3612189ba109465025eb0ad4ec
OPENWA_VERSION=0.23.3
API_PORT=2785

NODE_ENV=production
PORT=2785
BASE_URL=http://127.0.0.1:2785
DASHBOARD_URL=http://127.0.0.1:2785
CORS_ORIGINS=http://127.0.0.1:2785
CSP_UPGRADE_INSECURE_REQUESTS=false
TRUSTED_PROXIES=

# Replace these two markers using deploy/scripts/init-secrets.sh. Never commit the real file.
API_MASTER_KEY=__GENERATE_API_MASTER_KEY__
API_KEY_PEPPER=__GENERATE_API_KEY_PEPPER__
ALLOW_DEV_API_KEY=false
ENABLE_SWAGGER=false
VALIDATION_ERROR_DETAIL=false
MCP_ENABLED=false
MCP_READONLY=true
WEBHOOK_SSRF_PROTECT=true
WEBHOOK_SSRF_REDIRECTS=false
ALLOW_UNSIGNED_INGRESS=false

ENGINE_TYPE=whatsapp-web.js
MAX_CONCURRENT_SESSIONS=1
AUTO_START_SESSIONS=false
STATUS_SEED_ON_READY=false
RESOLVE_LID_TO_PHONE=true
SESSION_DATA_PATH=./data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu
WWEBJS_AUTH_TIMEOUT_MS=120000

DATABASE_TYPE=sqlite
DATABASE_NAME=./data/openwa.sqlite
MAIN_DATABASE_NAME=./data/main.sqlite
DATABASE_SYNCHRONIZE=false
MAIN_DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
REDIS_ENABLED=false
QUEUE_ENABLED=false
CACHE_ENABLED=false
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

# Conservative inbound API and outbound send pacing. Replies to existing chats are not
# counted as cold reachouts, but all successful sends still count toward the daily cap.
RATE_LIMIT_SHORT_TTL=1000
RATE_LIMIT_SHORT_LIMIT=3
RATE_LIMIT_MEDIUM_TTL=60000
RATE_LIMIT_MEDIUM_LIMIT=30
RATE_LIMIT_LONG_TTL=3600000
RATE_LIMIT_LONG_LIMIT=300
BODY_SIZE_LIMIT=10mb
INFLIGHT_BODY_BUDGET_BYTES=41943040
SEND_PACING_ENABLED=true
SEND_PACING_WARMUP_SCHEDULE=10,20,40,80
SEND_PACING_COLD_DAILY_CAP=2,3,5,10
SEND_PACING_BREAKER_THRESHOLD=3
SEND_PACING_BREAKER_COOLDOWN_MS=1800000
SIMULATE_TYPING=true
SIMULATE_TYPING_MAX_MS=5000

WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_DELAY=5000
WEBHOOK_DISPATCH_CONCURRENCY=2
WEBHOOK_DISPATCH_MAX_QUEUED=50
WEBHOOK_MAX_PER_SESSION=4
AUTOMATION_MAX_PER_SESSION=8
WEBHOOK_MAX_PAYLOAD_BYTES=1048576
WEBHOOK_MEDIA_INLINE_MAX_BYTES=262144
AUDIT_RETENTION_DAYS=90
LOG_LEVEL=warn
LOG_FORMAT=json

OPENWA_MEM_LIMIT=1280m
OPENWA_CPU_LIMIT=1.0
OPENWA_PIDS_LIMIT=768
